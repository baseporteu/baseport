# Copy to .env and adjust. Every value has a working default; nothing here is required to start the demo.

HOST=0.0.0.0
PORT=8100

# Bearer token every request must send: Authorization: Bearer <token>
# This is the same value you paste into a Baseport proxy table's "Bearer token" field.
API_TOKEN=demo-token-change-me

# Where the demo's own data lives. Deleting this file resets and reseeds the demo on next start.
DB_PATH=./demo.db

# Row counts. Purchase orders get 1-4 lines each, so PURCHASE_ORDER_LINES is derived, not set directly.
VENDOR_COUNT=60
PART_COUNT=400
PURCHASE_ORDER_COUNT=2000
